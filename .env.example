# Copy to .env and adjust. Never commit .env.

# server
DATABASE_URL=postgres://elemental:elemental@localhost:5432/elemental
PORT=2567
CORS_ORIGIN=http://localhost:5173
INVITE_CODES=ALPHA-001,ALPHA-002
# empty = disabled
SENTRY_DSN=
# delay between AI actions in ms (0 in tests)
AI_ACTION_DELAY_MS=400
# POST /auth/redeem attempts per IP per window
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info

# client
VITE_SERVER_URL=ws://localhost:2567
# empty = disabled
VITE_SENTRY_DSN=
