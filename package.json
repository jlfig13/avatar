{
  "name": "elemental",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @elemental/client --filter @elemental/server run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:sim": "pnpm --filter @elemental/server run sim",
    "lint": "biome check . && node tools/checkNoMathRandom.mjs",
    "format": "biome format --write .",
    "typecheck": "pnpm -r run typecheck",
    "validate:data": "pnpm --filter @elemental/game-data run validate:data",
    "db:generate": "pnpm --filter @elemental/server run db:generate",
    "db:migrate": "pnpm --filter @elemental/server run db:migrate",
    "db:ping": "pnpm --filter @elemental/server run db:ping",
    "db:seed": "pnpm --filter @elemental/server run db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
