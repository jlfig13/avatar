{
  "name": "@elemental/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@elemental/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "echo \"server dev: not implemented yet (SRV-01)\"",
    "db:ping": "node --env-file-if-exists=../../.env scripts/dbPing.ts",
    "sim": "node --conditions=@elemental/source scripts/simulate.ts"
  },
  "dependencies": {
    "@elemental/combat-core": "workspace:*",
    "@elemental/game-data": "workspace:*",
    "@elemental/shared": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
